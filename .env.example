# Copy to .env and fill in. Never commit .env.

# The reasoning brain (Anthropic / Claude)
ANTHROPIC_API_KEY=sk-ant-...
# Default is the flagship. For cheaper/faster runs use claude-sonnet-5.
ANTHROPIC_MODEL=claude-opus-5

# Live web retrieval (Tavily). Free tier: https://tavily.com
TAVILY_API_KEY=tvly-...

# Optional: how many results to pull per retrieval query
MAX_RESULTS_PER_QUERY=5
